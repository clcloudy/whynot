{
  "version": "activity-v1",
  "prototypes": [
    {
      "id": "find_colors",
      "category": "observe",
      "core_action": "从可见环境中辨认颜色。",
      "variation": "可看远处的一种颜色、找三种不同颜色，或给一组配色命名；不为寻找颜色离开当前位置。",
      "completion": "看过一种颜色或在心里收集好一组颜色即可结束。",
      "sources": [
        { "kind": "builtin", "action": "window" },
        { "kind": "builtin", "action": "palette" },
        { "kind": "builtin", "action": "colors" }
      ]
    },
    {
      "id": "listen_ambient",
      "category": "listen",
      "core_action": "留意真实环境中的声音。",
      "variation": "可分辨远近、持续时间、起伏或停顿；不用耳机，不屏蔽叫号和周围动静。",
      "completion": "辨认一种声音或听完一小段变化即可结束。",
      "sources": [
        { "kind": "builtin", "action": "sounds" },
        { "kind": "builtin", "action": "streetsound" },
        { "kind": "builtin", "action": "homelisten" },
        { "kind": "builtin", "action": "ambient" }
      ]
    },
    {
      "id": "notice_design",
      "category": "explore",
      "core_action": "发现眼前物件或标识中的一个设计细节。",
      "variation": "可辨认符号如何传意、比较圆与方，或沿招牌笔画看轮廓；只看当前位置能看到的部分。",
      "completion": "指出一个形状、笔画或易懂的设计理由即可结束。",
      "sources": [
        { "kind": "builtin", "action": "queue" },
        { "kind": "builtin", "action": "deskshape" },
        { "kind": "builtin", "action": "sign" }
      ]
    },
    {
      "id": "put_away",
      "category": "tidy",
      "core_action": "将手边一件暂时不用的小物归位。",
      "variation": "仅在桌前或家中整理自己手边可安全移动的物件；可以腾出空白，也可以放到下次容易找到的位置。",
      "completion": "一件小物归位即完成，不扩大整理范围。",
      "sources": [
        { "kind": "builtin", "action": "pen" },
        { "kind": "builtin", "action": "shelf" }
      ]
    },
    {
      "id": "look_far",
      "category": "observe",
      "core_action": "把目光从近处移向较远的物件。",
      "variation": "在桌前看房间另一端的物件轮廓，不必移动身体或寻找窗户。",
      "completion": "看清一次轮廓，再将目光带回眼前即可。",
      "sources": [{ "kind": "builtin", "action": "focus" }]
    },
    {
      "id": "observe_sky",
      "category": "observe",
      "core_action": "在户外观察一小片天空。",
      "variation": "可看天空的颜色或楼顶与天空的交界；先安全站定，始终留意周围，不直视太阳。",
      "completion": "留意到一处天空特征即可结束。",
      "sources": [{ "kind": "builtin", "action": "sky" }]
    },
    {
      "id": "trace_light",
      "category": "observe",
      "core_action": "沿房间里一块光影的边缘观察光的来处。",
      "variation": "只看当前位置可见的亮处和边缘，不追逐光影、不直视强光。",
      "completion": "看过一圈边缘，找到或猜到一个光源方向即可。",
      "sources": [{ "kind": "builtin", "action": "light" }]
    },
    {
      "id": "pause",
      "category": "rest",
      "core_action": "暂停操作，让身体自然放松片刻。",
      "variation": "不用完成任务或闭眼；保持安全停留并留意周围。",
      "completion": "歇一小会儿即可，没有必须达到的状态。",
      "sources": [{ "kind": "builtin", "action": "pause" }]
    },
    {
      "id": "name_moment",
      "category": "explore",
      "core_action": "给眼前的一个生活细节起短标题。",
      "variation": "选当前位置可见的细节，在心里命名即可，不要求拍照或记录。",
      "completion": "想出一个短标题即完成。",
      "sources": [{ "kind": "builtin", "action": "headline" }]
    },
    {
      "id": "imagine_use",
      "category": "explore",
      "core_action": "为一件日常用品想象一种新用途。",
      "variation": "仅在桌前或家中选眼前的小物，在心里设想，不拆改、不实际试验。",
      "completion": "想出一种具体用途即可结束。",
      "sources": [{ "kind": "builtin", "action": "invent" }]
    },
    {
      "id": "tell_story",
      "category": "explore",
      "core_action": "在心里编一个三句话故事。",
      "variation": "可用三个开头词，或在桌前、家中以眼前小物为主角；不要求写下或出声讲述。",
      "completion": "想到三句话即可结束。",
      "sources": [
        { "kind": "builtin", "action": "story" },
        { "kind": "builtin", "action": "tale" }
      ]
    },
    {
      "id": "breathe",
      "category": "rest",
      "core_action": "随着舒适的呼吸节奏数几轮。",
      "variation": "可站定，不依赖座位；不闭眼、不屏息，节奏不适时恢复自然呼吸。",
      "completion": "数完四轮或随时停下均可。",
      "sources": [{ "kind": "builtin", "action": "breathe" }]
    },
    {
      "id": "stretch",
      "category": "rest",
      "core_action": "用小幅度绕肩放松肩颈。",
      "variation": "可站定，不依赖座位或器材；不挤碰旁人，幅度以舒服为准。",
      "completion": "绕肩三圈或感到不适前停下即可。",
      "sources": [{ "kind": "builtin", "action": "stretch" }]
    },
    {
      "id": "anticipate_small",
      "category": "explore",
      "core_action": "想一件今天稍后值得期待的小事。",
      "variation": "只在心里形成一句话，不要求此刻执行或准备物品。",
      "completion": "用一句话说清一件小期待即可。",
      "sources": [{ "kind": "builtin", "action": "plan" }]
    },
    {
      "id": "sip_water",
      "category": "rest",
      "core_action": "喝一口手边的水并把杯子收好。",
      "variation": "需先确认有可安全饮用的水和自己的杯子；不要求找水、购买饮料或使用热饮。",
      "completion": "喝一口，盖紧杯子并放稳即可。",
      "sources": [{ "kind": "example", "id": "7b7e8fce1e1ebe92" }]
    },
    {
      "id": "review_flashcards",
      "category": "explore",
      "core_action": "回想并核对一小组已有词卡或复习卡片。",
      "variation": "依赖用户已有的学习材料；先限定一组，不临时搜集材料，不进入连续刷题。",
      "completion": "复习完预先选定的一组即停。",
      "sources": [{ "kind": "example", "id": "092f2178fc73e930" }]
    },
    {
      "id": "solve_question",
      "category": "explore",
      "core_action": "独立完成一道已有的选择题或错题。",
      "variation": "依赖已备好的题目；选能在预算内完成的一道，不展开第二道。",
      "completion": "完成一次作答和核对即可结束。",
      "sources": [{ "kind": "example", "id": "a8d222fe503ecf94" }]
    },
    {
      "id": "read_passage",
      "category": "explore",
      "core_action": "阅读一段预先选定的短文或两页书。",
      "variation": "依赖已有读物；先选定结束位置，只在自己的材料上做可选标记。",
      "completion": "读到选定位置就合上，不继续翻阅。",
      "sources": [{ "kind": "example", "id": "31d8ddb4d8308be1" }]
    },
    {
      "id": "listen_recording",
      "category": "listen",
      "core_action": "听一段已有的听力或播客录音。",
      "variation": "依赖已备音频、设备和耳机；仅供后续审核，不用于需要听叫号、交通提示的场景，不外放。",
      "completion": "一段结束就停止播放，不自动续播。",
      "sources": [{ "kind": "example", "id": "434aa735ca220715" }]
    },
    {
      "id": "rename_file",
      "category": "tidy",
      "core_action": "给一份已有学习图片或文件改成可搜索的名字。",
      "variation": "依赖用户自己的文件及管理工具；一次只改一个名称，不上传内容、不改他人的文件。",
      "completion": "保存一个能辨认内容的新名字即完成。",
      "sources": [{ "kind": "example", "id": "0e408466680234c6" }]
    },
    {
      "id": "triage_notifications",
      "category": "tidy",
      "core_action": "检查一条重要通知并判断是否需要回应。",
      "variation": "依赖用户自己的通知工具；只看选定入口，回应由用户确认，不自动发消息、不展开信息流。",
      "completion": "确认一条通知，必要时简短回复后关闭。",
      "sources": [{ "kind": "example", "id": "566f853600a07ed8" }]
    },
    {
      "id": "remove_digital_clutter",
      "category": "tidy",
      "core_action": "筛选一小组确认不再需要的截图或模糊照片。",
      "variation": "依赖用户自己的相册；先预览并由用户确认，优先可恢复删除，不清空回收站、不自动批量删除。",
      "completion": "处理选定的一小组就停，不继续翻找。",
      "sources": [{ "kind": "example", "id": "0a878620b36efd01" }]
    },
    {
      "id": "organize_apps",
      "category": "tidy",
      "core_action": "整理手机应用的入口或通知设置。",
      "variation": "依赖用户自己的设备；一次只挪一个常用图标或检查一项设置，关闭通知或订阅前由用户确认。",
      "completion": "完成一项明确的入口整理即可。",
      "sources": [{ "kind": "example", "id": "39662512f7bae7cf" }]
    },
    {
      "id": "discard_litter",
      "category": "tidy",
      "core_action": "从自己的包中挑出一件确认无用的小垃圾。",
      "variation": "依赖自己的包和可用的垃圾容器；先确认小票或卡片不再需要，不处理尖锐物，不为丢弃离队。",
      "completion": "安全丢弃一件无用物即可，不整理整包。",
      "sources": [{ "kind": "example", "id": "819b17fdb81562eb" }]
    },
    {
      "id": "capture_note",
      "category": "tidy",
      "core_action": "把一个想保留的词、店名或句子记入备忘录。",
      "variation": "依赖用户自己的记录工具；一次只存一条，不采集他人隐私，不要求上传。",
      "completion": "保存一条以后能读懂的短记录即可。",
      "sources": [{ "kind": "example", "id": "6a241292f915e4b3" }]
    },
    {
      "id": "update_todo",
      "category": "tidy",
      "core_action": "核对并划掉一条已经完成的待办。",
      "variation": "依赖已有的待办清单；只标记确实完成的一项，不重排整个计划。",
      "completion": "一条已完成事项被标记后即停。",
      "sources": [{ "kind": "example", "id": "6b38222dbf7bfb71" }]
    },
    {
      "id": "set_reminder",
      "category": "tidy",
      "core_action": "为一件明确的事设置一个提醒。",
      "variation": "依赖用户可用的提醒工具；由用户确认事项、时间和通知权限，不自动创建或承诺已设置。",
      "completion": "用户确认并保存一个提醒即可。",
      "sources": [{ "kind": "example", "id": "addcea7bae09a88b" }]
    },
    {
      "id": "check_wait_status",
      "category": "observe",
      "core_action": "查看一次叫号或下一班车的进度。",
      "variation": "依赖可见的官方显示或用户已有查询入口；留在原位，不反复刷新，不用猜测代替实时信息。",
      "completion": "确认一次当前进度并收回注意力即可。",
      "sources": [{ "kind": "example", "id": "c1baf46442276a90" }]
    },
    {
      "id": "prepare_ticket",
      "category": "tidy",
      "core_action": "提前打开即将使用的票码。",
      "variation": "依赖用户自己的有效票码和设备；只打开已有票码，不购买、不分享、不拍摄或上传票码。",
      "completion": "票码准备就绪即可，继续留意叫号或通行提示。",
      "sources": [{ "kind": "example", "id": "5a54c26a2de46cd8" }]
    },
    {
      "id": "check_device",
      "category": "observe",
      "core_action": "查看设备的电量、声音和网络状态。",
      "variation": "依赖用户自己的设备；只检查状态，修改设置前由用户确认，不关闭需要听到的提醒。",
      "completion": "完成一遍状态查看即可，不继续排查无关问题。",
      "sources": [{ "kind": "example", "id": "89036d246e9792e8" }]
    }
  ],
