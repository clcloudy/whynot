+.progress li.is-on{color:var(--on-stage)}
+.progress li.is-on i,.progress li.is-done b{color:#ff8a50}
+:root[data-theme="light"] .progress li.is-on i,:root[data-theme="light"] .progress li.is-done b{color:#b8480c}
