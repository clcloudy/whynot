+/* ---------- 页头与版心 ---------- */
+.masthead{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;max-width:none;min-height:64px;flex-wrap:wrap;column-gap:var(--wn-s2);padding:0 clamp(20px,4vw,56px);border-bottom:1px solid var(--stage-line);color:var(--on-stage)}
